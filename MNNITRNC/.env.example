# Copy to .env.local and fill in. .env.local is gitignored; this template is not.
#
# run-api.sh sources .env.local and exports these. ASP.NET maps the double
# underscore to a config section, so Email__Host becomes "Email:Host" and no
# credential needs to live in appsettings.json.
#
# Gmail specifically requires an APP PASSWORD (16 characters, no spaces) with
# 2-Step Verification enabled on the account -- a normal account password is
# always rejected with "535 5.7.8 Username and Password not accepted".
# Generate one at https://myaccount.google.com/apppasswords

Email__Host="smtp.gmail.com"
Email__Port="587"
Email__UseStartTls="true"
Email__User="your-address@gmail.com"
Email__Password="your-16-char-app-password"
Email__FromAddress="your-address@gmail.com"
Email__FromName="MNNIT R&C Portal"

# Base URL of the frontend; used to build the verification link in the email.
Email__PortalBaseUrl="http://localhost:5173"
