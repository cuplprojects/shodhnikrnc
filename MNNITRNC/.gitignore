# Environment configuration
.env
.env.*
# The template carries no secrets and is meant to be shared.
!.env.example
# The production API URL is public information (any browser request reveals
# it) and Vite's build needs it committed so a plain `npm run build` targets
# the right host without a manual .env.local edit first.
!UI/.env.production
env/
[Ee]nv/

# Runtime config: holds the database connection string, the JWT signing key and
# SMTP credentials. Untracked so secrets stay out of the repository -- copy
# appsettings.example.json to appsettings.json and fill it in.
API/API/appsettings.json
API/API/appsettings.Development.json
API/API/appsettings.Production.json

