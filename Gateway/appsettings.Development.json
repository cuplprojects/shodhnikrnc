{
  "_README": "Dev-only destinations -- both UIs run via `npm run dev` (Vite) and both APIs via `dotnet run`, all on localhost. A per-client Production config overrides only the cluster destination addresses, never the route shape itself.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "rnc-api": {
        "ClusterId": "rnc-api",
        "Match": { "Path": "/rnc/api/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/rnc" } ]
      },
      "rnc-ui": {
        "ClusterId": "rnc-ui",
        "Match": { "Path": "/rnc/{**catch-all}" }
      },
      "shodhanik-api": {
        "ClusterId": "shodhanik-api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "shodhanik-ui": {
        "ClusterId": "shodhanik-ui",
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "rnc-api": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7054/" }
        }
      },
      "rnc-ui": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5174/" }
        }
      },
      "shodhanik-api": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7290/" }
        }
      },
      "shodhanik-ui": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5173/" }
        }
      }
    }
  }
}
